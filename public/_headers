# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Order: more-specific paths first. With run_worker_first:false, prerendered HTML is
# served from .open-next/assets without middleware — this catch-all sets edge TTL.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400
  CDN-Cache-Control: max-age=3600
