{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "muhra1",
	"compatibility_date": "2026-05-11",
	"compatibility_flags": [
		"nodejs_compat",
		// https://opennext.js.org/cloudflare/get-started — public fetch in Workers
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// `true` runs the Worker before every static asset (/_next/static, fonts, …) and often causes Error 1102.
		// HTML cache headers come from `src/middleware.ts`; purge with `npm run cf:purge` after deploy if needed.
		"run_worker_first": false
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "muhra1"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
  /*
   * R2 staff media (images + video): create buckets first — `wrangler r2 bucket create muhra-media`
   * and `wrangler r2 bucket create muhra-media-preview` (preview is for local `wrangler dev` / OpenNext preview).
   * Staff uploads use R2 only (no Supabase Storage). Set `R2_PUBLIC_BASE_URL` to the HTTPS origin that serves objects.
   *   - R2_PUBLIC_BASE_URL — HTTPS origin for public objects (custom domain or *.r2.dev), no secrets in git.
   * Optional:
   *   - NEXT_PUBLIC_R2_PUBLIC_BASE_URL — same value for `next/image` remotePatterns at build time (Vercel/CI); Workers can rely on R2_PUBLIC_BASE_URL alone at runtime.
   */
	"r2_buckets": [
		{
			"binding": "MUHRA_MEDIA",
			"bucket_name": "muhra-media",
			"preview_bucket_name": "muhra-media-preview"
		}
	],
	"observability": {
		"enabled": true
	},
	// Public, non-secret variables. Secrets (SUPABASE_SERVICE_ROLE_KEY, STAFF_COOKIE_SECRET, STAFF_PASSWORD)
	// are configured via `wrangler secret put` or the dashboard — never commit them here.
	// STAFF_USERNAME is configured per-environment via dashboard (defaults to "staff" if unset).
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://www.muhrajewelry.com",
		"SUPABASE_URL": "https://jqiznpmpenabzudcljdl.supabase.co",
		"NEXT_PUBLIC_SUPABASE_URL": "https://jqiznpmpenabzudcljdl.supabase.co",
		"R2_PUBLIC_BASE_URL": "https://media.muhrajewelry.com",
		"NEXT_PUBLIC_R2_PUBLIC_BASE_URL": "https://media.muhrajewelry.com"
	}
}