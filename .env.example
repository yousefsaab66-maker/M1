# Copy to `.env.local` for development.
# Hosting env vars:
# - Netlify: Site → Environment variables
# - Cloudflare Workers: Worker → Settings → Variables and Secrets → tab **Production** (not Preview).
#   Add `SUPABASE_URL`, `SUPABASE_SERVICE_ROLE_KEY`, `STAFF_COOKIE_SECRET`, click Save, then **Deploy** a new version.
#   If a var «disappears» after deploy, the Git/CI binding may be overwriting config — set secrets in the dashboard for that worker only or sync via wrangler.
# Cloudflare build (this app): use `npm run build:cloudflare` then `npx wrangler deploy` / `npm run deploy` — do NOT use plain `next build` alone for Workers.
# Never commit `.env.local` or paste the service role key in chat.

# Supabase — project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Same URL, server-only — use on Cloudflare Workers (and set in build env) so/API and actions read it at runtime; avoids empty NEXT_PUBLIC_* baked into the bundle if missing at build time.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret — Settings → API → service_role (server only; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Storage bucket id (defaults to `muhra-products` if omitted). Create bucket + policies via SQL in repo: `supabase/migrations/*_muhra_product_images_storage.sql`
# SUPABASE_STORAGE_BUCKET=muhra-products

# Cloudflare R2 (optional) — when Worker has `MUHRA_MEDIA` binding + `R2_PUBLIC_BASE_URL`, staff uploads go to R2 instead of Supabase Storage. Create bucket: `wrangler r2 bucket create muhra-media` (and preview bucket per wrangler.jsonc). In the dashboard: allow public access for the bucket or attach a custom domain; set `R2_PUBLIC_BASE_URL` to that public origin (no trailing slash required).
# R2_PUBLIC_BASE_URL=https://media.muhrajewelry.com
# Optional duplicate for `next/image` remotePatterns at build time (same value as R2_PUBLIC_BASE_URL if you optimize staff images):
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.muhrajewelry.com

# Staff HTTPS cookie signing — random string at least 16 characters (e.g. `openssl rand -hex 24`)
STAFF_COOKIE_SECRET=

# Optional staff login overrides (otherwise defaults staff / staff12345678). In production, set STAFF_USERNAME and STAFF_PASSWORD via Worker secrets (e.g. wrangler secret put), not plain vars in repo.
# STAFF_USERNAME=staff
# STAFF_PASSWORD=
