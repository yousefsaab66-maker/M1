# Local setup (once): `npm run env:init` creates `.env.local` from this file if missing.
# Then edit `.env.local` with real values and restart `npm run dev` (required after changing env or next.config image hosts).
#
# Copy to `.env.local` for development.
# Hosting env vars:
# - Netlify: Site → Environment variables
# - Cloudflare Workers: Worker → Settings → Variables and Secrets → tab **Production** (not Preview).
#   Add `SUPABASE_URL`, `SUPABASE_SERVICE_ROLE_KEY`, `STAFF_COOKIE_SECRET`, click Save, then **Deploy** a new version.
#   If a var «disappears» after deploy, the Git/CI binding may be overwriting config — set secrets in the dashboard for that worker only or sync via wrangler.
# Cloudflare build (this app): use `npm run build:cloudflare` then `npx wrangler deploy` / `npm run deploy` — do NOT use plain `next build` alone for Workers.
# If the build machine has no `R2_PUBLIC_BASE_URL`, `next.config` still allows `https://media.muhrajewelry.com/**` for `next/image` (override with `MUHRA_IMAGE_HOST_FALLBACKS=` empty or comma list).
# If product images break only on the live domain: Cloudflare Images → Transformations → Sources must include `media.muhrajewelry.com` and your `*.supabase.co` host, OR deploy the build that uses `SafeImage` (remote URLs unoptimized in production).
# Never commit `.env.local` or paste the service role key in chat.

# Canonical public site URL (metadata, sitemap, Open Graph). Production default: https://www.muhrajewelry.com
NEXT_PUBLIC_SITE_URL=https://www.muhrajewelry.com

# Supabase — project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Same URL, server-only — use on Cloudflare Workers (and set in build env) so/API and actions read it at runtime; avoids empty NEXT_PUBLIC_* baked into the bundle if missing at build time.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret — Settings → API → service_role (server only; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (required for staff image/video uploads) — Worker binding `MUHRA_MEDIA` + public origin.
# Create bucket: `wrangler r2 bucket create muhra-media` (and preview bucket per wrangler.jsonc). Point `R2_PUBLIC_BASE_URL` at your public domain or *.r2.dev.
# Product/catalog data stays in Supabase Postgres only — no Supabase Storage for new uploads.
# R2_PUBLIC_BASE_URL=https://media.muhrajewelry.com
# CORS on bucket `muhra-media` (once): `npx wrangler r2 bucket cors put muhra-media --file scripts/r2-cors.json`
# Lets browsers load `site/storefront.json` from the CDN on all devices.
# Same origin string Next uses for `next/image` remotePatterns (read when `next dev` / `next build` starts). Use the exact public base your product `images[]` URLs use — including `http://127.0.0.1:PORT` for local R2 if applicable. Restart dev server after changing.
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.muhrajewelry.com
# If you only set `R2_PUBLIC_BASE_URL`, `next.config` still picks it up for remotePatterns — no need to duplicate unless you prefer the public name in client bundles too.

# Staff HTTPS cookie signing — random string at least 16 characters (e.g. `openssl rand -hex 24`)
STAFF_COOKIE_SECRET=

# Optional staff login overrides (otherwise defaults staff / staff12345678). In production, set STAFF_USERNAME and STAFF_PASSWORD via Worker secrets (e.g. wrangler secret put), not plain vars in repo.
# STAFF_USERNAME=staff
# STAFF_PASSWORD=

# Optional — only for running `npm run cf:purge` (or `npm run cf:purge:local` with vars in this file) after deploy (not required by the Worker). Create an API token with Zone → Cache Purge → Purge (Edit). If the live site still shows old pages after deploy, purge the zone or add a Cache Rule to bypass cache for HTML (everything except `/_next/static`).
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
